# --- Database ---
DATABASE_URL="postgresql://football:football@localhost:5432/football"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- WebSocket gateway (standalone process, see workers/ws-server.ts) ---
WS_PORT=4001
NEXT_PUBLIC_WS_URL="ws://localhost:4001"

# --- Auth.js ---
# generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- OpenAI (optional — LLM commentary falls back to the generated template,
#     and semantic matching falls back to deterministic + fuzzy matching,
#     if this is unset) ---
OPENAI_API_KEY=""

# --- FetchLayer (optional — workers/reddit-clip-poller.ts finds nothing and
#     logs "unconfigured" if this is unset; real goal clips still work via
#     the manual `scripts/backfill.ts --clips` + data/reddit-clips/ path).
#     https://fetchlayer.dev — pay-as-you-go, ~$0.002/request, one request
#     covers a whole match day regardless of how many games were on. ---
FETCHLAYER_API_KEY=""

# --- App ---
NODE_ENV="development"
