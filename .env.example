# --- Database ---
DATABASE_URL="postgresql://football:football@localhost:5432/football"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- WebSocket gateway (standalone process, see workers/ws-server.ts) ---
WS_PORT=4001
NEXT_PUBLIC_WS_URL="ws://localhost:4001"

# --- Auth.js ---
# generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- Sports data provider (football-data.org) ---
# https://www.football-data.org/client/register
SPORTS_API_KEY=""
SPORTS_API_BASE_URL="https://api.football-data.org/v4"

# --- AI matching provider (optional — semantic matching falls back to
#     deterministic + fuzzy matching if this is unset) ---
OPENAI_API_KEY=""

# --- Reddit (optional — social ingestion falls back to seeded/demo posts
#     if these are unset) ---
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="football-realtime/0.1 (by u/your-username)"

# --- App ---
NODE_ENV="development"
