# --- Database ---
DATABASE_URL="postgresql://football:football@localhost:5432/football"

# --- Redis (optional — see lib/redis/client.ts). Local dev via
#     docker-compose keeps this set, so `npm run dev` + the standalone
#     workers (npm run ws-server / worker:*) behave exactly as before,
#     talking to each other over real Redis pub/sub. Leave it UNSET for
#     the merged single-process deploy (server.ts, `npm start`) —
#     lib/redis/pubsub.ts and lib/redis/cache.ts fall back to in-process
#     alternatives automatically, since there's no longer a separate
#     process on the other end to talk to. Set it only if you split back
#     into multiple processes later. ---
REDIS_URL="redis://localhost:6379"

# --- WebSocket gateway. In the merged deploy (server.ts) this shares the
#     main port; PORT/WS_PORT here only matter if you run
#     `npm run ws-server` as its own standalone process instead. ---
WS_PORT=4001
NEXT_PUBLIC_WS_URL="ws://localhost:4001"

# --- Auth.js ---
# generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- OpenAI (optional — LLM commentary falls back to the generated template,
#     and semantic matching falls back to deterministic + fuzzy matching,
#     if this is unset) ---
OPENAI_API_KEY=""

# --- FetchLayer (optional — workers/reddit-clip-poller.ts finds nothing and
#     logs "unconfigured" if this is unset; real goal clips still work via
#     the manual `scripts/backfill.ts --clips` + data/reddit-clips/ path).
#     https://fetchlayer.dev — pay-as-you-go, ~$0.002/request, one request
#     covers a whole match day regardless of how many games were on. ---
FETCHLAYER_API_KEY=""

# --- App ---
NODE_ENV="development"
